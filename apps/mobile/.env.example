# Local Metro only. EAS never sees this file — `eas build` uploads the repo
# through git, which respects .gitignore, and .env.local is ignored. Build-time
# values for EAS live in eas.json under each profile's `env` block; the only
# real EAS environment variable is SENTRY_AUTH_TOKEN (see docs/runbooks/secrets.md).
#
# Both values below are non-secret by design: the API URL is a public host, and
# a Sentry DSN is an ingest key meant to ship inside client binaries.

# The local API. `pnpm dev` in apps/api binds 3001, not 3000 (3000 is web).
# lib/api.ts throws at import if this is unset, so a typo fails loudly at launch
# rather than as "fetch failed to undefined/v1/...".
#
# Point this at localhost for anything that sends an OTP. Against the staging or
# production API a resend is a real, billed Twilio SMS and a real user row —
# identity is the phone number, forever. The fixed test number 15005550006 /
# 123456 exists only in supabase/config.toml, i.e. the local stack.
EXPO_PUBLIC_API_URL=http://localhost:3001

EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn
