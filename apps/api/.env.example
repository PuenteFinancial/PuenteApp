# Server
PORT=3001
# "::" (dual-stack), not "0.0.0.0" — Node's fetch resolves localhost to ::1
# first, so an IPv4-only bind breaks the Next.js → API proxy (see local-dev.md)
HOST=::
NODE_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
# This API's own public base URL, no trailing slash. Not the web app's.
#   local   http://localhost:3001   (the simulator resolves localhost, so this
#                                    must be the port the API actually binds)
#   staging https://puenteapi-staging.up.railway.app
#   prod    https://puenteapi-production.up.railway.app
# The mobile KYC return leg redirects through this API and back into the app.
# Unset, the mobile branch of /v1/users/me/tos-link returns 503 rather than
# stranding a user in a browser. Web is unaffected either way.
PUBLIC_API_URL=http://localhost:3001
# Proxy hops in front of the API. Local dev has no proxy: 0. Railway
# staging/prod: 1 (the edge proxy) — verify on staging by comparing the
# audit log's `ip` field with your real IP. Never emulate trustProxy: true —
# leftmost X-Forwarded-For is client-controlled.
TRUST_PROXY_HOPS=0

# Sentry (optional)
SENTRY_DSN=
# Which deploy this is: staging | production. REQUIRED on Railway (both
# environments) — NODE_ENV is 'production' in both, so without this every
# staging event arrives tagged `production` and staging is indistinguishable
# from prod in Sentry. Also keeps the worker.heartbeat cron monitor separate
# per environment; sharing one would let a live prod worker mask a dead staging
# one. Leave blank locally (falls back to NODE_ENV → 'development').
SENTRY_ENVIRONMENT=

# Supabase — find in Supabase dashboard → Connect → App Frameworks
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# JWKS URL format: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Bridge — server-side only, never NEXT_PUBLIC_. Sandbox: https://dashboard.bridge.xyz
BRIDGE_API_KEY=
BRIDGE_API_BASE=https://api.bridge.xyz
# PEM public key issued by Bridge when the webhook is registered post-deploy —
# leave blank until then. Multiline PEM or single-line with \n both work.
BRIDGE_WEBHOOK_PUBLIC_KEY=

# Quote pricing (all optional — sane defaults in config/env.ts).
# Fee = flat + bps of send; buffer is subtracted from Bridge buy_rate;
# expiry is the firm-offer window in seconds.
QUOTE_FEE_FLAT_MINOR=0
QUOTE_FEE_BPS=100
QUOTE_FX_BUFFER_BPS=50
QUOTE_EXPIRY_SECONDS=900

# Funding (slice 4; 'stripe' available since S1). FUNDING_PROCESSOR=mock until
# Joshua flips Doppler. MOCK_FUNDING_WEBHOOK_SECRET must be set in dev/staging
# and NEVER in production — its absence 503s the funding webhook + confirm
# (the prod lock). Generate: openssl rand -hex 24
FUNDING_PROCESSOR=mock
MOCK_FUNDING_WEBHOOK_SECRET=
# Stripe (S1–S3) — ALL THREE required when FUNDING_PROCESSOR=stripe (boot
# refuses a partial trio): the secret key (sk_test_…/sk_live_…), the webhook
# endpoint signing secret (whsec_…), and the publishable key (pk_test_…/
# pk_live_…) that the funding-session endpoint serves to the web for the
# Payment Element. STRIPE_TIMEOUT_SECONDS bounds every SDK call (default 15,
# same contract as BRIDGE_TIMEOUT_SECONDS).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
#STRIPE_TIMEOUT_SECONDS=15
WAIT_FOR_CLEARING=false
# First-transfer hold (slice-8 O3): ON = a sender with no cleanly cleared send
# yet waits for their own funding_cleared before the payout submits (no hold
# reason; sweep resumes it). OFF for the trusted-five pilot; flip with real R01
# data before widening.
FIRST_TRANSFER_HOLD=false
CANCEL_WINDOW_MINUTES=30

# Dev-only routes (slice 7): POST /v1/dev/transfers/:id/simulate-funding, which
# backs the web "Simulate payment" button standing in for Stripe. It drives a
# transfer to FUNDED — a real ledger batch — with no real payment, so it needs
# BOTH this flag and MOCK_FUNDING_WEBHOOK_SECRET. dev/staging only, NEVER
# production. Left false here so a copied .env is safe by default.
ENABLE_DEV_ENDPOINTS=false

# Worker (slice 5) — the second Railway service (start:worker). All optional
# for the API process; the worker asserts DATABASE_URL and
# BRIDGE_TREASURY_WALLET_ID at startup and exits without them.
# DATABASE_URL must be the Supabase SESSION-mode pooler string (port 5432,
# postgres role) — never transaction mode (6543); pg-boss needs session
# semantics. Local dev: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
# Bridge treasury wallet id (USDC payout source; business customer)
BRIDGE_TREASURY_WALLET_ID=
# Crude aggregate float ceiling in USD minor units: payout submission pauses
# while the funding_receivable balance is at/above this (self-healing, no hold)
FLOAT_CEILING_MINOR=
# FX submission backstop (defaults in config/env.ts): max drift vs quote
# source_rate in bps, and max quote age in minutes, before an fx_drift hold
FX_MAX_DRIFT_BPS=200
FX_MAX_QUOTE_AGE_MINUTES=240
# Per-user transaction limits (slice-7 PR5; defaults in config/env.ts) — the AML
# launch limits. Send-principal caps (USD minor units) per transaction and per
# rolling window (day / month / 6 months), plus a per-day send count. Enforced at
# confirm and backstopped at FUNDED→SUBMITTED (a trip there → velocity_review hold).
# Defaulted (always-on even if unset).
RISK_PER_TXN_MAX_MINOR=150000
RISK_DAILY_MAX_MINOR=150000
RISK_MONTHLY_MAX_MINOR=300000
RISK_SEMIANNUAL_MAX_MINOR=1800000
RISK_VELOCITY_MAX_COUNT=5

# Per-phone budget on POST /v1/auth/otp/send — the endpoint is public and every
# call is a billed SMS. All three default in code, so leaving them unset keeps
# the control on. OTP_COOLDOWN_SECONDS must stay >= the clients' resend timer
# (OTP_RESEND_COOLDOWN_SECONDS in packages/shared) or Resend returns 429.
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_PER_DAY=10
# Uncleared-exposure cap (slice-8 O3): max committed sends in flight per user
# until their ACH settles (counted from disclosure acceptance to
# funding_cleared/unwind; no time window). 403 transfer_in_progress at
# quote/create/confirm; self-healing wait at FUNDED→SUBMITTED. Dev/staging: a
# second send blocks until `pnpm tsx scripts/fire-funding-webhook.ts <id> cleared`.
RISK_UNCLEARED_MAX_COUNT=1
# payout.poll cadence — 300 in prod, 60 in dev
WORKER_POLL_INTERVAL_SECONDS=300
# Stuck-transfer pager (slice-8 O1, transfers.stuck-watch cron): dwell past
# these thresholds pages Sentry, one issue per (transfer, state) episode.
# Hard code defaults — no Doppler sync needed; UNDER_REVIEW is calendar-blind.
STUCK_FUNDED_AFTER_MINUTES=15
STUCK_SUBMITTED_AFTER_MINUTES=30
STUCK_IN_FLIGHT_AFTER_MINUTES=60
STUCK_UNDER_REVIEW_AFTER_HOURS=24
# Ops page allowlist (slice 8.5-v1): comma-separated user UUIDs that may call
# GET /v1/ops/overview. FAIL-CLOSED: unset/empty = the route is not
# registered; non-members get 404 (never 403).
OPS_ADMIN_USER_IDS=
# Ops write capability (slice 8.5-v1.1): second control of the double-control
# gate on POST /v1/ops/cancellations/resolve. Set independently of the
# allowlist (identity × capability): staging can carry OPS_ADMIN_USER_IDS with
# writes off. Exact string 'true' to enable; unset/'false' = the write route
# is not registered.
OPS_WRITE_ENABLED=false

# AES-256-GCM key for encrypting sensitive payout-destination fields (CLABE)
# at rest. 32 bytes base64 — generate with: openssl rand -base64 32
# Boot fails without it (and fails loudly on a malformed key).
DETAILS_ENCRYPTION_KEY=

# Twilio — required once OTP auth is active (leave blank until then)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
