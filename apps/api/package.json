{
  "name": "@puente/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup src/server.ts src/worker.ts --format esm",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src/ scripts/",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "dev:e2e": "node --env-file=.env.e2e.local --import tsx src/server.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@puente/shared": "workspace:*",
    "@sentry/node": "^10.69.0",
    "@supabase/supabase-js": "^2.112.2",
    "fastify": "^5.11.2",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.8",
    "pg-boss": "^12.27.0",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}