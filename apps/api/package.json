{
  "name": "@puente/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup src/server.ts src/worker.ts --format esm",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "ci:boot-smoke": "tsx scripts/ci-boot-smoke.ts",
    "lint": "eslint src/ scripts/",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "dev:e2e": "node --env-file=.env.e2e.local --import tsx src/server.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@puente/shared": "workspace:*",
    "@sentry/node": "^10.72.0",
    "@supabase/supabase-js": "^2.112.4",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.10",
    "pg-boss": "^12.28.1",
    "stripe": "^22.6.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}