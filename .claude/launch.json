{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@puente/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@puente/api",
        "run",
        "dev:e2e"
      ],
      "port": 3001
    },
    {
      "name": "api-crypto",
      "runtimeExecutable": "doppler",
      "runtimeArgs": [
        "run",
        "--project",
        "puente-api",
        "--config",
        "stg_main",
        "--",
        "env",
        "FUNDING_PROCESSOR=stripe_crypto",
        "pnpm",
        "--filter",
        "@puente/api",
        "dev"
      ],
      "port": 3001
    }
  ]
}